{
  "name": "aether-launcher",
  "version": "1.0.38",
  "description": "High-performance, ultra-low CPU Minecraft launcher with containers, Modrinth integration, robust auto-updates, and crash diagnostics",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aether": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "package": "node scripts/package_windows.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sqikpeek/Aether.git"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "modrinth",
    "fabric",
    "forge",
    "neoforge",
    "quilt",
    "containers"
  ],
  "author": "Sqikpeek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Sqikpeek/Aether/issues"
  },
  "homepage": "https://github.com/Sqikpeek/Aether#readme",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@yao-pkg/pkg": "^6.25.0",
    "typescript": "^5.7.2"
  }
}
